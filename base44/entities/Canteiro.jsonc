{
  "name": "Canteiro",
  "type": "object",
  "properties": {
    "estufa": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4
      ],
      "description": "N\u00famero da estufa"
    },
    "lado": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ],
      "description": "Lado da estufa"
    },
    "vao": {
      "type": "integer",
      "description": "N\u00famero do v\u00e3o"
    },
    "numero": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4
      ],
      "description": "N\u00famero do canteiro dentro do v\u00e3o (1 a 4)"
    },
    "variedades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "quantidade": {
            "type": "integer"
          }
        }
      },
      "description": "Variedades plantadas (m\u00e1x 4, total m\u00e1x 2000 mudas)"
    },
    "total_mudas": {
      "type": "integer",
      "description": "Total de mudas no canteiro"
    }
  },
  "required": [
    "estufa",
    "lado",
    "vao",
    "numero"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}