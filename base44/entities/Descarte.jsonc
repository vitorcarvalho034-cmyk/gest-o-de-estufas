{
  "name": "Descarte",
  "type": "object",
  "properties": {
    "estufa": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "lado": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "vao": {
      "type": "integer",
      "description": "N\u00famero do v\u00e3o"
    },
    "canteiro": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4
      ],
      "description": "Canteiro dentro do v\u00e3o"
    },
    "variedade": {
      "type": "string"
    },
    "quantidade": {
      "type": "integer",
      "description": "Quantidade de mudas descartadas"
    },
    "motivo": {
      "type": "string",
      "enum": [
        "Doen\u00e7a",
        "Praga",
        "Qualidade",
        "Excesso",
        "Outro"
      ]
    },
    "observacao": {
      "type": "string"
    },
    "data_descarte": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "estufa",
    "lado",
    "vao",
    "canteiro",
    "variedade",
    "quantidade",
    "motivo",
    "data_descarte"
